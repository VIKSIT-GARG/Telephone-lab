SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SARVAM_JUDGE_MODEL=sarvam-105b
TELEPHONE_RUNS_DIR=runs
TELEPHONE_ENABLE_LIVE=false
# Phase 2 hosted/runtime configuration (no secret values in source)
INDEPENDENT_JUDGE_ENABLED=true
INDEPENDENT_JUDGE_MODEL=gemma4
DAILY_SPEND_CAP_INR=25
PER_USER_DAILY_CALLS=120
PER_USER_WINDOW_REQUESTS=40
REVIEW_RETENTION_DAYS=30
# Opt-in local evaluations; fail closed unless explicit live flag and caps supplied.
EVAL_MAX_CALLS=24
EVAL_SPEND_CAP_INR=5
